{
  "name": "local-semantic-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply CACHE_DB --local",
    "types": "wrangler types",
    "test": "vitest run",
    "benchmark": "node --experimental-strip-types bench/run.mjs",
    "benchmark:fetch": "node bench/fetch-banking77.mjs",
    "assets:build": "node architecture/export-assets.mjs",
    "check": "npm run types && tsc --noEmit && vitest run"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "latest",
    "@cloudflare/vitest-plugin": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  }
}
